---
import '../css/global.css'
import { Font } from 'astro:assets'
import type { Header } from '@types'

export interface Props extends Header {}

const { meta } = Astro.props

const tagline = 'I make tools. Software is just the lever.'
const title = meta.title || `Frank Stallone | ${tagline}`
const description = meta.description || tagline
const canonicalURL = new URL(
  meta.canonicalURL || Astro.url.pathname,
  Astro.site,
)
const ogImage = new URL(
  meta.image || '/media/frank-stallone-tools-og.png',
  Astro.site,
)
ogImage.protocol = 'https:'
const imageAlt =
  meta.imageAlt ||
  (!meta.image
    ? 'Frank Stallone. I make tools. Software is just the lever.'
    : undefined)
const type = meta.type || 'website'
const robots = meta.robots
---

<head>
  <meta charset="UTF-8" />
  <script is:inline>
    // Set the entrance state before the browser can paint the hero.
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.dataset.heroIntroPending = ''
      // Keep the content readable if the animation bundle fails to load.
      window.setTimeout(() => {
        delete document.documentElement.dataset.heroIntroPending
      }, 3000)
    }
  </script>
  <Font
    cssVariable="--font-display"
    preload={[
      { weight: 500, style: 'normal' },
      { weight: 700, style: 'normal' },
    ]}
  />
  <Font
    cssVariable="--font-base"
    preload={[
      { weight: 400, style: 'normal' },
      { weight: 500, style: 'normal' },
    ]}
  />
  <Font cssVariable="--font-mono" />
  <!-- Meta -->
  <meta name="description" content={description} />
  {robots && <meta name="robots" content={robots} />}
  <meta name="viewport" content="width=device-width" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#161616" />
  <meta name="theme-color" content="#fcfcfc" />
  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />
  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />

  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <!-- Open Graph -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage.href} />
  {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
  <meta property="og:site_name" content="Frank Stallone" />
  {
    type === 'article' && (
      <>
        <meta name="author" content="Frank Stallone" />
        <meta property="article:author" content={Astro.site?.href} />
        {meta.publishedTime && (
          <meta
            property="article:published_time"
            content={meta.publishedTime}
          />
        )}
      </>
    )
  }

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage.href} />
  {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}

  <!-- Google tag (gtag.js) -->
  <script
    async
    is:inline
    src="https://www.googletagmanager.com/gtag/js?id=G-NJMVWJT1D7"
    type="text/partytown"></script>
  <script is:inline type="text/partytown">
    window.dataLayer = window.dataLayer || []
    function gtag() {
      dataLayer.push(arguments)
    }
    gtag('js', new Date())

    gtag('config', 'G-NJMVWJT1D7')
  </script>
</head>
