---
interface Props {
  /** The current number of likes for this post */
  count: number
  /** The unique identifier for the post */
  slug: string
}

const { count, slug } = Astro.props
---

<post-likes
  id="like-button"
  data-initial={count}
  data-slug={slug}
  class="inline-flex align-center justify-center"
>
  <button
    aria-label="Click to like this post"
    class="post-likes__button border border-gray-700 rounded-md flex justify-center align-center px-xs py-2xs bg-transparent text-step-00 text-gray-1400 disabled:opacity-50 disabled:cursor-not-allowed"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 512 512"
      fill="currentColor"
      class="self-center"
    >
      <title>Like button icon</title>
      <path
        d="M240 67.7V32h96V67.7c0 38.1-9 75.1-25.8 108.3H464h48v96H496v80H472v72H448v56H400 280 265.5l-12.1-8.1-72-48L160 409.7V384 320 224 200.9l18-14.4 7.9-6.4c34.2-27.3 54-68.7 54-112.4zM128 192V480H0V192H128z"
      ></path></svg
    >
    <span class="ml-2xs font-display font-bold tabular-nums">
      <span class="sr-only">This post's current likes:</span>
      <span data-like-count>{count}</span>
    </span></button
  >
</post-likes>

<script>
  import { animate } from 'motion'

  import { motionDuration, motionEasing } from '@lib/motion'

  interface LikeResponse {
    liked?: boolean
    count?: number
  }

  interface APIError {
    message: string
    code?: string
  }

  class Likes extends HTMLElement {
    private count: number
    private readonly slug: string
    private readonly likeButton: HTMLButtonElement
    private readonly countValue: HTMLSpanElement
    private liked: boolean
    private isUpdating: boolean
    private readonly shouldReduceMotion: boolean
    private errorAnimation: ReturnType<typeof animate> | null

    constructor() {
      super()

      const initial = this.dataset.initial
      const slug = this.dataset.slug

      if (!initial) {
        throw new Error('Likes component: data-initial attribute is required')
      }
      if (!slug) {
        throw new Error('Likes component: data-slug attribute is required')
      }

      this.count = Number(initial)
      if (isNaN(this.count)) {
        throw new Error('Likes component: data-initial must be a valid number')
      }

      this.slug = slug
      const button = this.querySelector('button')
      const countValue = this.querySelector('[data-like-count]')

      if (!button || !countValue || !(countValue instanceof HTMLSpanElement)) {
        throw new Error('Likes component: Required elements not found')
      }

      this.likeButton = button
      this.countValue = countValue
      this.liked = false
      this.isUpdating = true
      this.errorAnimation = null
      this.shouldReduceMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches
    }

    connectedCallback() {
      // Set the initial count
      if (this.count !== 0) {
        this.countValue.textContent = this.count.toString()
      }
      // Add event listener to the button
      this.addLikeButtonEventListener()
      // Update the liked state before allowing user interaction
      void this.hydrateLikedState()
    }

    disconnectedCallback() {
      this.errorAnimation?.stop()
      this.errorAnimation = null
    }

    private addLikeButtonEventListener() {
      this.likeButton.addEventListener('click', async (e) => {
        e.preventDefault()

        // Prevent multiple rapid clicks
        if (this.isUpdating) {
          return
        }

        try {
          this.isUpdating = true
          this.likeButton.disabled = true
          await this.handleLikeClick()
        } catch (error) {
          console.error('Error handling like click:', error)
          this.showError('Failed to update like status. Please try again.')
        } finally {
          this.isUpdating = false
          this.likeButton.disabled = false
        }
      })
    }

    private async handleLikeClick() {
      // Store initial state for rollback
      const initialCount = this.count
      const wasLiked = this.liked
      const desiredLiked = !this.liked

      // Optimistic update
      this.liked = desiredLiked
      this.count = this.liked ? this.count + 1 : Math.max(0, this.count - 1)
      this.updateUI()
      this.animateFeedback()

      try {
        const response = await this.sendLikeRequest(desiredLiked)

        if (!response.ok) {
          const error = (await response.json()) as APIError
          throw new Error(error.message || 'Server error')
        }

        this.applyServerState((await response.json()) as LikeResponse)
        this.updateUI()
      } catch (error) {
        // Revert on error
        this.count = initialCount
        this.liked = wasLiked
        this.updateUI()
        throw error // Re-throw for the caller
      }
    }

    private async sendLikeRequest(liked: boolean): Promise<Response> {
      return fetch(`/api/like-post/${this.slug}/`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ slug: this.slug, liked }),
      })
    }

    private async hydrateLikedState() {
      this.isUpdating = true
      this.likeButton.disabled = true
      try {
        await this.updateLikedState()
        this.isUpdating = false
        this.likeButton.disabled = false
      } catch (error) {
        console.error('Error fetching like state:', error)
        this.showError('Failed to load like status')
        this.setUnavailableState()
      }
    }

    private applyServerState({ liked, count }: LikeResponse) {
      if (typeof liked === 'boolean') {
        this.liked = liked
      }
      if (typeof count === 'number') {
        this.count = count
      }
    }

    private setUnavailableState() {
      this.isUpdating = true
      this.likeButton.disabled = true
      this.likeButton.setAttribute(
        'aria-label',
        'Likes are unavailable right now.',
      )
    }

    private updateUI() {
      if (this.liked) {
        this.likeButton.classList.add('bg-gray-1400', 'text-gray-100')
        this.likeButton.classList.remove('bg-transparent', 'text-gray-1400')
        this.likeButton.setAttribute(
          'aria-label',
          `Thank you! Click to unlike this post. This post has been liked ${this.count} times.`,
        )
      } else {
        this.likeButton.classList.remove('bg-gray-1400', 'text-gray-100')
        this.likeButton.classList.add('bg-transparent', 'text-gray-1400')
        this.likeButton.setAttribute(
          'aria-label',
          `Click to like this post. This post has been liked ${this.count} times.`,
        )
      }
      this.countValue.textContent = this.count.toString()
    }

    private animateFeedback() {
      if (this.shouldReduceMotion) {
        return
      }

      animate(
        this.likeButton,
        {
          transform: ['scale(1)', 'scale(1.03)', 'scale(1)'],
        },
        {
          duration: motionDuration.ui,
          ease: motionEasing.out,
        },
      )

      animate(
        this.countValue,
        {
          opacity: [0, 1],
          transform: [`translateY(${this.liked ? -4 : 4}px)`, 'translateY(0)'],
        },
        {
          duration: motionDuration.ui,
          ease: motionEasing.out,
        },
      )
    }

    private async updateLikedState() {
      const response = await fetch(`/api/like-post/${this.slug}/`, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
        },
      })

      if (!response.ok) {
        throw new Error('Failed to fetch like state')
      }

      this.applyServerState((await response.json()) as LikeResponse)
      this.updateUI()
    }

    private showError(message: string) {
      console.error(message)
      this.errorAnimation?.stop()
      this.errorAnimation = null

      if (this.shouldReduceMotion) {
        return
      }

      this.errorAnimation = animate(
        this.likeButton,
        {
          transform: [
            'translateX(0)',
            'translateX(-2px)',
            'translateX(2px)',
            'translateX(0)',
          ],
        },
        {
          duration: motionDuration.ui,
          ease: motionEasing.out,
        },
      )
    }
  }

  if (!customElements.get('post-likes')) {
    customElements.define('post-likes', Likes)
  }
</script>

<style>
  .post-likes__button {
    transition:
      background-color var(--motion-duration-ui) var(--motion-ease-out),
      color var(--motion-duration-ui) var(--motion-ease-out),
      scale var(--motion-duration-release) var(--motion-ease-out);
  }

  .post-likes__button:active {
    transition:
      background-color var(--motion-duration-ui) var(--motion-ease-out),
      color var(--motion-duration-ui) var(--motion-ease-out),
      scale var(--motion-duration-press) var(--motion-ease-out);
  }

  @media (prefers-reduced-motion: reduce) {
    .post-likes__button,
    .post-likes__button:active {
      transition:
        background-color var(--motion-duration-ui) var(--motion-ease-out),
        color var(--motion-duration-ui) var(--motion-ease-out);
    }
  }
</style>
