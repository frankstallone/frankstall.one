---
const pathname = Astro.url.pathname
---

<section class="contact-section" id="contact" aria-labelledby="contact-title">
  <div class="home-chapter wrapper">
    <div class="home-section-head">
      <h2 id="contact-title">Contact</h2>
      <p>Availability, partnerships, and questions.</p>
    </div>
    <div class="contact-content">
      <div class="contact-intro" id="book-call">
        <h3>Want to work together?</h3>
        <p>
          I have limited availability for consulting. Learn how{' '}
          <a
            href="https://designzen.co"
            target="_blank"
            rel="noopener noreferrer"
            >I can sharpen your SaaS brand and product</a
          >, or send me a note below.
        </p>
        <a
          class="contact-brand"
          href="https://designzen.co"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src="/media/designzen-wordmark.svg"
            alt="Designzen"
            width="100"
            height="25"
          />
        </a>
      </div>
      <form
        name="main"
        netlify-honeypot="bot-field"
        class="contact-form"
        method="POST"
        data-netlify="true"
        action="/"
        aria-label="Reach out"
      >
        <input type="hidden" name="form-name" value="main" />
        <input
          type="hidden"
          name="subject"
          value={`Form submission: frankstall.one${pathname}`}
        />
        <p hidden>
          <label for="bot-field">Leave this field empty</label>
          <input
            name="bot-field"
            id="bot-field"
            tabindex="-1"
            autocomplete="off"
          />
        </p>
        <div class="contact-field">
          <label for="name">Name</label>
          <input
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            required
          />
        </div>
        <div class="contact-field">
          <label for="email">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </div>
        <div class="contact-field contact-field-wide">
          <label for="tel">Phone number <span>(optional)</span></label>
          <input id="tel" name="tel" type="tel" autocomplete="tel" />
        </div>
        <div class="contact-field contact-field-wide">
          <label for="message">Message</label>
          <textarea name="message" id="message" rows="5" required></textarea>
        </div>
        <button type="submit" class="button contact-submit">Send message</button
        >
      </form>
    </div>
  </div>
</section>
