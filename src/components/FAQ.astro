---
type Props = {
  idx: number
  question: string
  answer: string
}

const { idx, question, answer } = Astro.props
---

<div class="box flex flex-col bg-transparent border border-gray-700">
  <details open={idx === 0}>
    <summary class="faq-button">
      {question}
      <span class="faq-icon" aria-hidden="true">
        <svg class="plus-icon" viewBox="0 0 24 24">
          <path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" fill="currentColor"
          ></path>
          <path d="M0 0h24v24H0z" fill="none"></path>
        </svg>
        <svg class="minus-icon" viewBox="0 0 24 24">
          <path d="M19 13H5v-2h14v2z" fill="currentColor"></path>
          <path d="M0 0h24v24H0z" fill="none"></path>
        </svg>
      </span>
    </summary>
    <div class="accordion-body">
      <p>
        {answer}
      </p>
    </div>
  </details>
</div>

<style>
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    display: inline-grid;
    flex: none;
    width: 1.5em;
    height: 1.5em;
  }

  .faq-icon svg {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    transition:
      opacity 160ms var(--motion-ease-out),
      transform 160ms var(--motion-ease-out);
  }

  .plus-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .minus-icon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.95);
  }

  details[open] .plus-icon {
    opacity: 0;
    transform: rotate(90deg) scale(0.95);
  }

  details[open] .minus-icon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }

  .accordion-body {
    opacity: 1;
    transform: translateY(0);
    clip-path: inset(0);
    transition:
      opacity var(--motion-duration-ui) var(--motion-ease-out),
      transform var(--motion-duration-ui) var(--motion-ease-out),
      clip-path var(--motion-duration-ui) var(--motion-ease-out);
  }

  @starting-style {
    details[open] .accordion-body {
      opacity: 0;
      transform: translateY(-4px);
      clip-path: inset(0 0 100% 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-icon svg {
      transform: none;
      transition: opacity 160ms var(--motion-ease-out);
    }

    details[open] .plus-icon,
    details[open] .minus-icon {
      transform: none;
    }

    .accordion-body {
      transform: none;
      clip-path: inset(0);
      transition: opacity 160ms var(--motion-ease-out);
    }

    @starting-style {
      details[open] .accordion-body {
        opacity: 0;
        transform: none;
        clip-path: inset(0);
      }
    }
  }
</style>
