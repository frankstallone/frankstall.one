---
import FluxCapacitorHero from './flux-capacitor-hero.astro'
import Header from './Header.astro'
---

<div id="hero" aria-label="Hero section" class="bg-gray-100 text-gray-1400">
  <Header />
  <div class="wrapper region hero-stage">
    <div class="hero-copy">
      <div class="flow prose">
        <h1 class="text-step-5 text-balance hero-headline-alt">
          I make tools. Software is just the lever.
        </h1>
      </div>
    </div>
    <FluxCapacitorHero />
  </div>
</div>
