---
import Header from './Header.astro'
import FluxCapacitorHero from './flux-capacitor-hero.astro'
---

<div id="hero" class="home-hero">
  <Header />
  <div class="wrapper home-intro">
    <div class="home-intro-copy">
      <h1 class="hero-headline-alt">
        I make tools.
        <span>Software is just the lever.</span>
      </h1>
      <p>
        I'm Frank, a designer and developer working where design, systems, and
        craft meet.
      </p>
    </div>
    <FluxCapacitorHero
      sizes="(min-width: 60rem) 22rem, (min-width: 47.5rem) 34vw, 16rem"
    />
  </div>
</div>
