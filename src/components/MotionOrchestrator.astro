---

---

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    html[data-hero-intro-pending] #hero .flow.prose > *,
    html[data-hero-intro-pending] #hero #logo-link,
    html[data-hero-intro-pending] #hero .nav-item {
      opacity: 0;
    }
  }
</style>

<script>
  import { animate, inView, stagger } from 'motion'
  import { animate as animateHero } from 'motion/mini'
  import type { Easing } from 'motion'

  import { motionDuration, motionEasing } from '@lib/motion'

  const shouldReduceMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)',
  ).matches

  if (!shouldReduceMotion) {
    type RevealOptions = {
      delay?: number | ReturnType<typeof stagger>
      blur?: number | boolean
      ease?: Easing
      duration?: number
      y?: number
    }

    type HeroAnimationConfig = {
      blur: number
      duration: number
      delay: number
      yOffset: number
      easing: 'linear' | 'gentle' | 'smooth' | 'snappy'
    }

    const defaultHeroConfig: HeroAnimationConfig = {
      blur: 18,
      duration: 1.2,
      delay: 0.12,
      yOffset: 28,
      easing: 'gentle',
    }

    const heroEaseByPreset: Record<HeroAnimationConfig['easing'], Easing> = {
      gentle: [0.25, 0.1, 0.25, 1],
      smooth: [0.4, 0, 0.2, 1],
      snappy: [0.18, 0.89, 0.32, 1.28],
      linear: 'linear',
    }

    let heroAnimationControls: ReturnType<typeof animateHero> | null = null

    const getHeroConfig = () => {
      const windowConfig = (
        window as Window & {
          __heroAnimationConfig?: HeroAnimationConfig
        }
      ).__heroAnimationConfig

      return {
        ...defaultHeroConfig,
        ...windowConfig,
      }
    }

    const reveal = (
      targets: Element | Element[],
      options: RevealOptions = {},
    ) => {
      const blur = typeof options.blur === 'number' ? options.blur : null
      const keyframes = (blur
        ? {
            opacity: [0, 1] as [number, number],
            y: [options.y ?? 8, 0] as [number, number],
            filter: [`blur(${blur}px)`, 'blur(0px)'] as [string, string],
          }
        : {
            opacity: [0, 1] as [number, number],
            y: [options.y ?? 8, 0] as [number, number],
          }) as unknown as Parameters<typeof animate>[1]

      return animate(targets, keyframes, {
        duration: options.duration ?? motionDuration.reveal,
        ease: options.ease ?? motionEasing.out,
        delay: options.delay,
      })
    }

    const revealInView = (
      container: Element,
      targets: Element[],
      options: RevealOptions = {},
    ) => {
      if (!targets.length) {
        return
      }

      let hasAnimated = false
      inView(
        container,
        () => {
          if (hasAnimated) {
            return
          }

          hasAnimated = true
          reveal(targets, options)
        },
        { amount: 0.2 },
      )
    }

    const revealMosaicInView = (container: Element, targets: Element[]) => {
      if (!targets.length) {
        return
      }

      let hasAnimated = false
      inView(
        container,
        () => {
          if (hasAnimated) {
            return
          }

          hasAnimated = true
          animate(
            targets,
            {
              opacity: [0, 1],
              transform: ['scale(0.95)', 'scale(1)'],
            },
            {
              duration: motionDuration.reveal,
              ease: motionEasing.out,
              delay: stagger(0.05),
            },
          )
        },
        { amount: 0.2 },
      )
    }

    const heroIntroTargets = Array.from(
      document.querySelectorAll('#hero .flow.prose > *'),
    )
    const runHeroIntro = () => {
      if (!heroIntroTargets.length) {
        return
      }

      const { blur, duration, delay, yOffset, easing } = getHeroConfig()

      heroAnimationControls?.stop()
      heroAnimationControls = animateHero(
        heroIntroTargets,
        {
          opacity: [0, 1],
          transform: [`translateY(${yOffset}px)`, 'translateY(0px)'],
          filter: [`blur(${blur}px)`, 'blur(0px)'],
        },
        { delay, duration, ease: heroEaseByPreset[easing] },
      )
    }

    const heroIntroPending = document.documentElement.hasAttribute(
      'data-hero-intro-pending',
    )

    // Once the loading fallback reveals the hero, do not hide it again.
    if (heroIntroPending && heroIntroTargets.length) {
      runHeroIntro()
    }

    window.addEventListener('hero-animation-config-change', runHeroIntro)

    const heroNavTargets = Array.from(
      document.querySelectorAll('#hero #logo-link, #hero .nav-item'),
    )
    if (heroIntroPending && heroNavTargets.length) {
      animateHero(
        heroNavTargets,
        { opacity: [0, 1], transform: ['translateY(-6px)', 'translateY(0px)'] },
        {
          duration: motionDuration.reveal,
          ease: motionEasing.out,
          delay: stagger(0.03),
        },
      )
    }

    delete document.documentElement.dataset.heroIntroPending

    document.querySelectorAll('.home-section-head').forEach((sectionHead) => {
      revealInView(sectionHead, Array.from(sectionHead.children), {
        delay: stagger(0.04),
      })
    })

    document
      .querySelectorAll(
        '.home-about-copy, .home-about-media, .contact-book-call, .contact-reach-out, #contact.flow.prose:not(.contact-reach-out)',
      )
      .forEach((element) => {
        const children = Array.from(element.children)
        revealInView(element, children.length ? children : [element])
      })

    document
      .querySelectorAll('.home-posts-grid, .home-portfolio-grid')
      .forEach((grid) => {
        revealInView(grid, Array.from(grid.children), { delay: stagger(0.06) })
      })

    document.querySelectorAll('.grid').forEach((grid) => {
      const cards = Array.from(grid.querySelectorAll(':scope > .post-card'))
      if (cards.length === 0) {
        return
      }

      revealInView(grid, cards, { delay: stagger(0.05) })
    })

    document.querySelectorAll('[data-motion-mosaic]').forEach((mosaic) => {
      const swatches = Array.from(
        mosaic.querySelectorAll('[data-motion-swatch]'),
      )
      revealMosaicInView(mosaic, swatches)
    })
  }
</script>
