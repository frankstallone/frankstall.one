---
import Header from './Header.astro'
const { title, subtitle, reading = false } = Astro.props

type Props = {
  title: string
  subtitle?: string
  reading?: boolean
}

const description = subtitle
  ? subtitle
  : 'A time-traveling mix of startup, agency, enterprise, and life lessons'
---

<div id="hero" aria-label="Hero section" class="bg-gray-100 text-gray-1400">
  <Header />
  <div class:list={['wrapper page-intro', { 'page-intro-reading': reading }]}>
    <div class="flow prose page-intro-copy">
      <h1 class="text-balance hero-headline-alt">
        {title}
      </h1>
      <p>{description}</p>
    </div>
  </div>
</div>
