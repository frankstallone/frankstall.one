---
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'
import AboutMe from '@components/AboutMe.astro'

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 2)

const dateFormat = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
})
---

<Layout meta={{}}>
  <section
    class="home-chapter wrapper"
    id="main"
    aria-labelledby="writing-title"
  >
    <div class="home-section-head">
      <h2 id="writing-title">Recent writing</h2>
      <p>Notes on design, systems, and craft.</p>
      <a data-astro-prefetch="hover" href="/blog/">All posts</a>
    </div>
    <ol role="list" class="home-posts">
      {
        latestPosts.map((post) => (
          <li class="home-post">
            <time datetime={post.data.publishDate.toISOString().slice(0, 10)}>
              {dateFormat.format(post.data.publishDate)}
            </time>
            <h3>
              <a
                data-astro-prefetch="hover"
                href={`/${post.collection}/${post.id}/`}
              >
                {post.data.title}
              </a>
            </h3>
            <p>{post.data.description}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="home-chapter wrapper" aria-labelledby="work-title">
    <div class="home-section-head">
      <h2 id="work-title">Selected work</h2>
      <p>From the system to the smallest detail.</p>
      <a data-astro-prefetch="hover" href="/portfolio/">Full portfolio</a>
    </div>
    <article class="home-work">
      <video
        id="phone-input-demo"
        class="home-work-video"
        loop
        muted
        playsinline
        controls
        preload="none"
        width="3496"
        height="2160"
        poster="/media/klaviyo/klaviyo-phone-input-cover-web.png"
        aria-label="Klaviyo phone number input demonstration"
      >
        <source
          src="/media/klaviyo/klaviyo-phone-input-cover-web.webm"
          type="video/webm"
        />
        <p>
          <a href="/portfolio/klaviyo-asecnt-design-system-phone-input/">
            Read the phone number input case study.
          </a>
        </p>
      </video>
      <div class="home-work-copy">
        <p class="home-meta">Klaviyo · Ascent Design System</p>
        <h3>
          <a
            data-astro-prefetch="hover"
            href="/portfolio/klaviyo-asecnt-design-system-phone-input/"
            >Phone number input</a
          >
        </h3>
        <p>
          I designed a phone number input from the ground up, bringing product,
          engineering, content, accessibility, and marketing teams around one
          component.
        </p>
      </div>
    </article>
  </section>

  <AboutMe />
</Layout>

<script>
  const video = document.querySelector<HTMLVideoElement>('#phone-input-demo')
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

  if (video) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect()
          if (!reducedMotion.matches) {
            video.play().catch(() => {
              // Native controls remain available if autoplay is blocked.
            })
          }
        }
      },
      { threshold: 0.25 },
    )
    observer.observe(video)

    reducedMotion.addEventListener('change', (event) => {
      if (event.matches) video.pause()
    })
  }
</script>
