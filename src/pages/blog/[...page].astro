---
import { getCollection, type CollectionEntry } from 'astro:content'
import type { Page } from 'astro'
import InnerLayout from '../../layouts/InnerLayout.astro'

export const getStaticPaths = async ({ paginate }: { paginate: Function }) => {
  const allPosts = (await getCollection('blog')).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
  )
  return paginate(allPosts, { pageSize: 10 })
}

interface Props {
  page: Page<CollectionEntry<'blog'>>
}

const { page } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const dateFormat = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
})
---

<InnerLayout
  meta={{
    title: 'Blog posts by Frank Stallone',
    description: 'I make tools. Software is just the lever.',
    canonicalURL: canonicalURL.href,
  }}
>
  <section class="writing-index wrapper" id="main">
    <ol role="list" class="writing-list">
      {
        page.data.map((post) => (
          <li class="writing-entry">
            <time datetime={post.data.publishDate.toISOString().slice(0, 10)}>
              {dateFormat.format(post.data.publishDate)}
            </time>
            <div>
              <h2>
                <a
                  data-astro-prefetch="hover"
                  href={`/${post.collection}/${post.id}/`}
                >
                  {post.data.title}
                </a>
              </h2>
              <p>{post.data.description}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <nav
      aria-label="Blog pages"
      class="flex justify-between items-center text-step-00 text-gray-1100 tabular-nums"
    >
      {
        page.url.prev ? (
          <a data-astro-prefetch="hover" href={page.url.prev}>
            ← Previous
          </a>
        ) : (
          <span class="text-gray-1100">← Previous</span>
        )
      }
      <span>
        Page {page.currentPage} of {page.lastPage}
      </span>
      {
        page.url.next ? (
          <a data-astro-prefetch="hover" href={page.url.next}>
            Next →
          </a>
        ) : (
          <span class="text-gray-1100">Next →</span>
        )
      }
    </nav>
  </section>
</InnerLayout>
